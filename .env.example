# --- Sahiy API ---
LOGIN=your_login
PASSWORD=your_password
LOGIN_FIELD=login
BASE_URL=https://api.market.sahiy.uz

# Promptlar .env da EMAS — Postgres'da. Dashboard → /prompts bo'limidan
# tahrirlanadi (base, order, cat:*, block:*): qo'shish, tahrirlash, kalitni
# o'zgartirish, o'chirish, tarix va rollback.

# --- AI xarajati (token → USD) ---
# Tokenlar provayder javobidan olinadi (aniq son). Narx esa 1 MILLION token
# uchun USD'da. Bo'sh qoldirilsa kodda yozilgan jadval ishlatiladi; jadvaldagi
# narx eskirgan bo'lsa shu yerda ustidan yozing (billing sahifangiz bilan
# solishtiring).
AI_PRICE_IN=
AI_PRICE_CACHED_IN=
AI_PRICE_OUT=
# Oylik chegara (USD). Oshsa xodimlar guruhiga bir marta ogohlantirish
# yuboriladi — agent to'xtamaydi. 0 yoki bo'sh = o'chiq.
AI_BUDGET_USD=

# --- Lokal model (Ollama) — loyihadagi YAGONA AI provayderi ---
# Docker'da ishlatsangiz: http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# RAM: model shuncha vaqt bo'sh tursa RAM'dan bo'shatiladi.
# "0" — har javobdan keyin darhol bo'shatadi (RAM eng kam, javob sekinroq
# boshlanadi), "2m" — muvozanat, "30m" — tez lekin ~5 GB band turadi.
OLLAMA_KEEP_ALIVE=2m
# RAM: kontekst oynasi. Kattalashtirsangiz KV-kesh uchun ko'proq RAM ketadi.
OLLAMA_NUM_CTX=4096
# Javobning eng ko'p tokeni (cheksiz generatsiya va uzoq kutishga qarshi)
OLLAMA_MAX_TOKENS=600
# 0.2 — javoblar barqaror bo'lsin (yuqori qiymat = ijodkor, lekin beqaror)
OLLAMA_TEMPERATURE=0.2
# Lokal model sekin ishlaydi — timeout uzun
OLLAMA_TIMEOUT_SEC=180

# --- Agent ---
# Bo'sh qoldirsangiz token'dagi sub (admin id) ishlatiladi
AGENT_SENDER_ID=
# true bo'lsa Gemini javobini avtomatik yuboradi, false bo'lsa faqat ko'rsatadi
AUTO_REPLY=false
# AI'ga beriladigan xabarlarning eng ko'p soni (yuqori chegara, kamida 10)
HISTORY_LIMIT=20

# --- Token tejash ---
# AI'ga butun tarix emas, faqat javob berilmagan YANGI xabarlar beriladi.
# Ulardan oldin nechta xabar kontekst uchun qo'shiladi:
CONTEXT_BEFORE=4
# Oxirgi mijoz xabari shundan eski bo'lsa AI'ga umuman yuborilmaydi
# (0 = cheklovsiz). Masalan 24 — bir kundan eski murojaatga javob yozilmaydi.
MAX_MESSAGE_AGE_HOURS=24


# --- Adminka buyurtmalari: GET /api/admin/daigou-orders ---
# Xitoy tomonidagi ma'lumot: yo'lga chiqqan sana, posilka, trek raqami.
# "Buyurtmam qachon keladi?" savoliga shu manba ishlatiladi.
USER_BASE_URL=https://api.sahiy.uz
ADMINKA_TOKEN_BEARER=

# --- Telegram eskalatsiya (xodimlar guruhi) ---
# Userbot (MTProto) orqali ishlaydi — pastdagi API_ID/API_HASH ga qarang.
# Bo'sh qoldirilsa ALLOWED_GROUPS dagi birinchi guruh ishlatiladi.
TELEGRAM_CHAT_ID=-1001234567890

# --- Web dashboard ---
WEB_ADDR=:8080
# Dashboard Basic Auth (bo'sh qoldirilsa dashboard parolsiz ochiq!)
ADMIN_USER=admin
ADMIN_PASS=change_me
# true bo'lsa frontend fayllar diskdan o'qiladi (lokal ishlab chiqish uchun)
WEB_DEV=false

# --- Telegram userbot (MTProto) ---
API_ID=1234567
API_HASH=your_api_hash
TG_PHONE=+99890xxxxxxx
TG_SESSION=/data/tg-session.json
ALLOWED_GROUPS=-1001234567890,-1009876543210

# --- Ma'lumotlar bazasi (Docker Compose avtomatik beradi) ---
# Docker'da compose DATABASE_URL va DATA_DIR ni o'zi o'rnatadi.
# Lokal (docker'siz) ishlatish uchun:
# DATABASE_URL=postgres://sahiy:sahiy@localhost:5432/sahiy?sslmode=disable
# DATA_DIR=.

# Birinchi ishga tushishda mavjud suhbatlarga javob berilsinmi (odatda false)
BACKFILL=false

# --- Ikkinchi sayt: buyurtma holati (api.sahiy.uz service API) ---
SERVICE_BASE_URL=https://api.sahiy.uz
SERVICE_PHONE=your_service_phone
SERVICE_PASSWORD=your_service_password
# Device maydonlari majburiy — ularsiz login 500 qaytaradi
SERVICE_DEVICE_ID=any-stable-uuid
SERVICE_DEVICE_NAME=phone
SERVICE_DEVICE_TYPE=mobile
SERVICE_APK_TYPE=2
SERVICE_FCM_TOKEN=


# --- Zaxira model (Groq) — lokal Ollama ishlamaganda ishlaydi ---
# Kalitni bo'sh qoldirsangiz zaxira o'chadi va agent faqat lokal modelda ishlaydi.
GROQ_API_KEY=
# MUHIM: model JSON Schema'ni qo'llab-quvvatlashi SHART. llama-3.3-70b,
# llama-3.1-8b va groq/compound buni BILMAYDI — "does not support response
# format json_schema" xatosini qaytaradi.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SEC=60
# gpt-oss oilasi javobdan oldin "reasoning" tokenlarini sarflaydi va ular ham
# max_tokens hisobidan ketadi. Bo'sh qoldiring — kod "low" ni o'zi qo'yadi.
GROQ_REASONING_EFFORT=
# 1 mln token uchun USD (console.groq.com/settings/billing dan oling).
# Faqat shu modelga tegishli — lokal model bepulligicha qoladi.
GROQ_PRICE_IN=
GROQ_PRICE_OUT=

# --- Prompt zanjiri ---
# Zanjirning BIRINCHI qadami — /prompts sahifasida prompt yonida turgan #id.
# Keyingi qadamlarni model o'zi ko'rsatadi: har prompt faqat JSON qaytaradi
# va uning ichida `prompt_id` bo'ladi. `prompt_id` 0 bo'lsa zanjir tugaydi
# va `client` maydonidagi matn mijozga yuboriladi.
START_PROMPT_ID=

# --- Baza (postgres) va auth ---
# To'liq satr berilsa DB_* e'tiborsiz qoladi:
# DB_DSN=postgres://sahiy:sahiy@localhost:5432/sahiy?sslmode=disable
DB_DSN=
DB_HOST=localhost
DB_PORT=5432
DB_USER=sahiy
DB_PASSWORD=sahiy
DB_NAME=sahiy
DB_SSLMODE=disable
# docker compose: baza konteyneri host'ning qaysi portida ko'rinadi
# (lokal postgres 5432 ni band qilgani uchun default 5433)
DB_PORT_HOST=5433
DB_TIMEZONE=Asia/Tashkent
# JWT imzo kaliti — prodda albatta tasodifiy qiymat qo'ying
JWT_SECRET=

# --- AI agent (Groq) ---
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Javob JSON bo'lishi shart (response_format: json_object)
GROQ_MAX_TOKENS=800
# Zanjir: qaysi promtdan boshlanadi va eng ko'p necha bosqich
START_PROMPT_ID=1
AGENT_MAX_STEPS=5
# Fon sikli: har necha sekundda yangi xabarlar tekshiriladi
POLL_INTERVAL_SEC=60
CHATS_LIMIT=30

# --- Telegram (help kaliti shu guruhga ketadi) ---
TELEGRAM_BOT_TOKEN=
# Bot API manzili (odatda o'zgartirilmaydi; sinov uchun)
TELEGRAM_API_URL=
TELEGRAM_GROUP_ID=-1005441158507

# --- Frontend (React dev serveri) ---
CORS_ORIGIN=http://localhost:5173
